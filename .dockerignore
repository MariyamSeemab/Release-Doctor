# Keep the Docker build context lean for the root-context backend image
# (Dockerfile.backend). Only backend/ and demo-repository/ are needed.

# Version control
.git
.gitignore

# Frontend (not part of the backend image)
frontend

# Infra / CDK
infra
cdk.out

# Node
**/node_modules

# Python caches / local artifacts
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
backend/*.db
backend/release_doctor.db

# Bob session transcripts and docs not needed at runtime
bob_sessions

# Env files (never bake secrets into images)
.env
**/.env

# Editor / OS cruft
.vscode
.idea
.DS_Store
