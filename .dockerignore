# Root build context ignore for the backend image (Dockerfile.backend), which
# builds from the repo root. Dockerfile.backend only COPYs backend/ and
# demo-repository/, so we only need to trim heavy/irrelevant paths here.
#
# NOTE: do NOT exclude whole top-level app dirs like `frontend/` — CDK stages
# each DockerImageAsset from its own directory and this file can be consulted
# during that staging, which previously wiped the frontend build context.

# Version control
.git

# Node / build artifacts anywhere
**/node_modules
**/.next
infra/aws-cdk/cdk.out

# Python caches / local DBs
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/*.db

# Never bake env files with secrets into images
**/.env
**/.env.local

# Editor / OS cruft
.vscode
.idea
.DS_Store
