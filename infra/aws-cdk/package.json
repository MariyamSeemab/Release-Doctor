{
  "name": "release-doctor-infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK infrastructure for Release Doctor (ECS Fargate + RDS + ALB)",
  "bin": {
    "release-doctor-infra": "bin/release-doctor.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "synth": "cdk synth",
