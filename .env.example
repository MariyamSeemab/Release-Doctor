# ─────────────────────────────────────────────────────────────────
# Release Doctor — Environment Variables Example
# Copy this file to .env and fill in real values before running.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Postgres ──────────────────────────────────────────────────────
POSTGRES_USER=releasedoctor
POSTGRES_PASSWORD=releasedoctor
POSTGRES_DB=releasedoctor

# ── JWT Auth ──────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=changeme-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Redis / Celery ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Backend ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://releasedoctor:releasedoctor@localhost:5432/releasedoctor
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ── AI / Orchestration ────────────────────────────────────────────
# IBM Bob 2.0 agent orchestration
IBM_BOB_API_KEY=
IBM_BOB_ENDPOINT=

# OpenAI fallback (optional)
OPENAI_API_KEY=

# ── Observability (optional) ──────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=release-doctor
