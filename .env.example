# ─────────────────────────────────────────────────────────────────
# Release Doctor — Environment Variables
# Copy this file to .env and fill in real values before running.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Postgres ──────────────────────────────────────────────────────
# Local dev defaults. On Railway, set DATABASE_URL directly from the
# PostgreSQL plugin — it will be in postgresql+asyncpg:// format.
POSTGRES_USER=releasedoctor
POSTGRES_PASSWORD=releasedoctor
POSTGRES_DB=releasedoctor
DATABASE_URL=postgresql+asyncpg://releasedoctor:releasedoctor@localhost:5432/releasedoctor

# ── JWT Auth ──────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Redis / Celery ────────────────────────────────────────────────
# On Railway, set these from the Redis plugin connection string.
# If Redis is not available, set USE_INLINE_TASKS=true (see below).
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Inline task mode ──────────────────────────────────────────────
# Set to true to run analysis tasks in-process without Redis/Celery.
# Useful for free-tier deployments with a single dyno and no Redis.
# Analyses will still complete — they just run in the FastAPI process.
USE_INLINE_TASKS=false

# ── Backend ───────────────────────────────────────────────────────
LOG_LEVEL=INFO

# CORS: comma-separated list of allowed frontend origins.
# For production set this to your Vercel frontend URL.
# Example: CORS_ORIGINS=https://release-doctor.vercel.app
CORS_ORIGINS=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────
# Set these to your deployed backend URL when deploying to Vercel.
# Example: NEXT_PUBLIC_API_URL=https://release-doctor-backend.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ── AI / Orchestration ────────────────────────────────────────────
# Both are optional — the app runs static analysis without them.
# IBM Bob 2.0 agent orchestration
IBM_BOB_API_KEY=
IBM_BOB_ENDPOINT=

# OpenAI fallback (optional)
OPENAI_API_KEY=

# ── Observability (optional) ──────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=release-doctor
